{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@stravyx/types": ["packages/types/src/index.ts"],
      "@stravyx/api-client": ["packages/api-client/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "apps/app-web/.next", ".venv-pdf"]
}
